# Copy to .env and change TZ to an IANA timezone, e.g. America/Chicago.
TZ=Etc/UTC
FRIGATE_PORT=5000
CPAI_PORT=32168
CAMERA_MANAGER_PORT=8971
CAMERA_SCAN_SECONDS=30
LIGHT_SCAN_SECONDS=10
# go2rtc's local ingest/snapshot API is used by automatic day/night switching.
GO2RTC_API_PORT=1984

# Optional generic outbound webhook for completed person events. Leave empty to
# disable. The relay POSTs an application/json event payload with a bearer token
# when WEBHOOK_TOKEN is set.
WEBHOOK_URL=
WEBHOOK_TOKEN=
WEBHOOK_POLL_SECONDS=10
# Set this to Frigate's LAN URL when the webhook receiver needs a usable
# snapshot URL, e.g. http://192.168.1.50:5000.
FRIGATE_PUBLIC_URL=http://frigate:5000

# The Frigate account password is set on its first browser visit, not here.
# Do not put secrets in a committed .env file.
